# DukaFlow AI local development variables
# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=dukaflow
MYSQL_USER=dukaflow_user
MYSQL_PASSWORD=replace_with_a_secure_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_secure_root_password

BACKEND_PORT=8080
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MS=86400000

VITE_API_BASE_URL=http://localhost:8080/api
VITE_AI_SERVICE_URL=http://localhost:8000

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
